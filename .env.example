# Copy this file to .env in the project root. Keep the real key private.
OPENROUTER_API_KEY=replace-with-your-openrouter-key
# Optional: choose a vision-capable model. The free router accepts images.
OPENROUTER_MODEL=openrouter/free

# Required for the single-owner login. Run `npm run auth:password -w @storyboard/api`
# and paste the generated hash here. Do not use the plaintext password.
AUTH_USERNAME=ehudaiuser
AUTH_PASSWORD_HASH='replace-with-generated-hash'
# For a separately hosted frontend, set its exact HTTPS origin, without a trailing slash.
# AUTH_ALLOWED_ORIGIN=https://your-frontend.example.com
# For Vercel and a different-site API domain, HTTPS cookies require `none`.
# AUTH_COOKIE_SAME_SITE=none
